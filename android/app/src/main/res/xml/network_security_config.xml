<?xml version="1.0" encoding="utf-8"?>
<!-- Yerel ağdaki TV'ler (http, ws) için şifresiz bağlantıya izin ver. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
